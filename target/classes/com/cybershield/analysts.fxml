<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cybershield.controller.AnalystController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="header-label" text="Analyst Management" />

    <GridPane hgap="15.0" vgap="15.0" styleClass="stat-card">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>

        <Label text="Analyst ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtId" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="e.g. A-001" />

        <Label text="Name:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtName" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Skill:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtSkill" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Experience Level:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtExperience" GridPane.columnIndex="3" GridPane.rowIndex="1" promptText="e.g. Senior" />

        <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="cbStatus" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <HBox spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="2" GridPane.columnSpan="2">
            <Button mnemonicParsing="false" onAction="#addAnalyst" styleClass="action-button" text="Add Analyst" />
            <Button mnemonicParsing="false" onAction="#refreshTable" styleClass="action-button" text="Refresh" />
        </HBox>
    </GridPane>

    <TableView fx:id="tableAnalysts" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
            <TableColumn fx:id="colName" prefWidth="150.0" text="Name" />
            <TableColumn fx:id="colSkill" prefWidth="150.0" text="Skill" />
            <TableColumn fx:id="colExperience" prefWidth="120.0" text="Experience" />
            <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
        </columns>
    </TableView>
</VBox>
