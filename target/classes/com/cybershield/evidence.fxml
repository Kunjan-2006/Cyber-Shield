<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cybershield.controller.EvidenceController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="header-label" text="Evidence Management" />

    <GridPane hgap="15.0" vgap="15.0" styleClass="stat-card">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>

        <Label text="Incident ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtIncidentId" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Type:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <ComboBox fx:id="cbType" prefWidth="150.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Collected By:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtCollectedBy" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextArea fx:id="txtDescription" prefHeight="60.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="2" />

        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="3">
            <Button mnemonicParsing="false" onAction="#addEvidence" styleClass="action-button" text="Add Evidence" />
            <Button mnemonicParsing="false" onAction="#filterByIncident" styleClass="action-button" text="Filter by Incident ID" />
            <Button mnemonicParsing="false" onAction="#refreshTable" styleClass="action-button" text="Refresh" />
        </HBox>
    </GridPane>

    <TableView fx:id="tableEvidence" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="100.0" text="Evidence ID" />
            <TableColumn fx:id="colIncidentId" prefWidth="100.0" text="Incident ID" />
            <TableColumn fx:id="colType" prefWidth="120.0" text="Type" />
            <TableColumn fx:id="colDescription" prefWidth="200.0" text="Description" />
            <TableColumn fx:id="colCollectedBy" prefWidth="120.0" text="Collected By" />
            <TableColumn fx:id="colTime" prefWidth="150.0" text="Collection Time" />
            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
        </columns>
    </TableView>
</VBox>
