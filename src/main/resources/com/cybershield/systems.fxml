<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cybershield.controller.SystemController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="header-label" text="Affected Systems Management" />

    <GridPane hgap="15.0" vgap="15.0" styleClass="stat-card">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>

        <Label text="System ID:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtId" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="System Name:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtName" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Department:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtDepartment" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="IP Address:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtIp" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label text="Type:" GridPane.columnIndex="4" GridPane.rowIndex="1" />
        <TextField fx:id="txtType" GridPane.columnIndex="5" GridPane.rowIndex="1" />

        <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <ComboBox fx:id="cbStatus" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <HBox spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="2" GridPane.columnSpan="4">
            <Button mnemonicParsing="false" onAction="#addSystem" styleClass="action-button" text="Add System" />
            <Button mnemonicParsing="false" onAction="#refreshTable" styleClass="action-button" text="Refresh" />
        </HBox>
    </GridPane>

    <TableView fx:id="tableSystems" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="100.0" text="System ID" />
            <TableColumn fx:id="colName" prefWidth="150.0" text="Name" />
            <TableColumn fx:id="colDepartment" prefWidth="120.0" text="Department" />
            <TableColumn fx:id="colIp" prefWidth="120.0" text="IP Address" />
            <TableColumn fx:id="colType" prefWidth="120.0" text="Type" />
            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
        </columns>
    </TableView>
</VBox>
