<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cybershield.controller.IncidentController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="header-label" text="Incident Management" />

    <!-- Form Section -->
    <GridPane hgap="15.0" vgap="15.0" styleClass="stat-card">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>
        
        <Label text="Reporter:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <TextField fx:id="txtReporter" GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <Label text="Incident Type:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <ComboBox fx:id="cbType" prefWidth="150.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Severity:" GridPane.columnIndex="4" GridPane.rowIndex="0" />
        <ComboBox fx:id="cbSeverity" prefWidth="150.0" GridPane.columnIndex="5" GridPane.rowIndex="0" />

        <Label text="Affected System ID:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="txtSystemId" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Required Skill:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtSkill" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label text="Description:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextArea fx:id="txtDescription" prefHeight="60.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.columnSpan="5" GridPane.rowIndex="2" />

        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.columnSpan="5">
             <Button mnemonicParsing="false" onAction="#createIncident" styleClass="action-button" text="Create Incident" />
             <Button mnemonicParsing="false" onAction="#processNextIncident" styleClass="process-button" text="Process Next Incident (Priority Queue)" />
             <Button mnemonicParsing="false" onAction="#refreshTable" styleClass="action-button" text="Refresh List" />
        </HBox>
    </GridPane>

    <!-- Table Section -->
    <TableView fx:id="tableIncidents" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="120.0" text="ID" />
            <TableColumn fx:id="colReporter" prefWidth="120.0" text="Reporter" />
            <TableColumn fx:id="colType" prefWidth="120.0" text="Type" />
            <TableColumn fx:id="colSeverity" prefWidth="100.0" text="Severity" />
            <TableColumn fx:id="colSkill" prefWidth="150.0" text="Required Skill" />
            <TableColumn fx:id="colStatus" prefWidth="120.0" text="Status" />
        </columns>
    </TableView>
</VBox>
