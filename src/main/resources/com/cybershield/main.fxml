<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane fx:id="mainBorderPane" prefHeight="768.0" prefWidth="1024.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cybershield.controller.MainController">
    <left>
        <VBox prefWidth="220.0" spacing="10.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="sidebar-title" text="CyberShield" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <padding>
                        <Insets bottom="20.0" left="15.0" right="15.0" top="20.0" />
                    </padding>
                </Label>
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showDashboard" styleClass="sidebar-button" text="Dashboard" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showIncidents" styleClass="sidebar-button" text="Incidents" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showAnalysts" styleClass="sidebar-button" text="Analysts" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showSystems" styleClass="sidebar-button" text="Affected Systems" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showEvidence" styleClass="sidebar-button" text="Evidence" />
                <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#showOperations" styleClass="sidebar-button" text="Response Operations" />
            </children>
            <padding>
                <Insets bottom="10.0" top="10.0" />
            </padding>
        </VBox>
    </left>
</BorderPane>
