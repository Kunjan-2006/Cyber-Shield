<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cybershield.controller.OperationController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label styleClass="header-label" text="Response Operations" />

    <GridPane hgap="15.0" vgap="15.0" styleClass="stat-card">
        <padding>
            <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
        </padding>

        <Label text="Select an operation from the table, then apply a valid status transition below." GridPane.columnIndex="0" GridPane.rowIndex="0" GridPane.columnSpan="4" />

        <Label text="New Status:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <ComboBox fx:id="cbNewStatus" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <Label text="Resolution Notes:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextArea fx:id="txtResolutionNotes" prefHeight="60.0" prefWidth="250.0" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2" GridPane.columnSpan="3">
            <Button mnemonicParsing="false" onAction="#updateOperationStatus" styleClass="action-button" text="Update Status" />
            <Button mnemonicParsing="false" onAction="#refreshTable" styleClass="action-button" text="Refresh Table" />
        </HBox>
    </GridPane>

    <TableView fx:id="tableOperations" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="100.0" text="Operation ID" />
            <TableColumn fx:id="colIncidentId" prefWidth="100.0" text="Incident ID" />
            <TableColumn fx:id="colAnalystId" prefWidth="100.0" text="Analyst ID" />
            <TableColumn fx:id="colStart" prefWidth="140.0" text="Start Time" />
            <TableColumn fx:id="colEnd" prefWidth="140.0" text="End Time" />
            <TableColumn fx:id="colStatus" prefWidth="100.0" text="Status" />
            <TableColumn fx:id="colNotes" prefWidth="200.0" text="Notes" />
        </columns>
    </TableView>
</VBox>
